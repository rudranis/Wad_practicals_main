<!DOCTYPE html>
<html>

<head>
    <title>Result</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <h2>
        <%= title %>
    </h2>

    <a href="/">Back</a>

    <table border="1">
        <tr>
            <th>Name</th>
            <th>Roll</th>
        </tr>

        <% students.forEach(s=> { %>
            <tr>
                <td>
                    <%= s.Name %>
                </td>
                <td>
                    <%= s.Roll_No %>
                </td>
            </tr>
            <% }) %>

    </table>

</body>

</html>