<!DOCTYPE html>
<html>

<head>
    <title>Student Dashboard</title>
    <link rel="stylesheet" href="/style.css">
</head>

<body>

    <h1>Student Management System</h1>

    <h3>Total Students: <%= count %>
    </h3>

    <!-- BUTTONS -->
    <a href="/insert"><button>Insert Data</button></a>
    <a href="/dsbda"><button>DSBDA > 20</button></a>
    <a href="/above25"><button>>25 ALL Subjects</button></a>
    <a href="/less40"><button>
            <40 WAD & CC</button></a>

    <br><br>

    <!-- UPDATE -->
    <form action="/update" method="POST">
        <input type="number" name="roll" placeholder="Roll No to Update">
        <button type="submit">Update +10 Marks</button>
    </form>

    <!-- DELETE -->
    <form action="/delete" method="POST">
        <input type="number" name="roll" placeholder="Roll No to Delete">
        <button type="submit">Delete</button>
    </form>

    <br>

    <!-- TABLE -->
    <table border="1">
        <tr>
            <th>Name</th>
            <th>Roll</th>
            <th>WAD</th>
            <th>CC</th>
            <th>DSBDA</th>
            <th>CNS</th>
            <th>AI</th>
            <th>Total</th>
            <th>%</th>
        </tr>

        <% students.forEach(s=> { %>
            <tr>
                <td>
                    <%= s.Name %>
                </td>
                <td>
                    <%= s.Roll_No %>
                </td>
                <td>
                    <%= s.WAD_Marks %>
                </td>
                <td>
                    <%= s.CC_Marks %>
                </td>
                <td>
                    <%= s.DSBDA_Marks %>
                </td>
                <td>
                    <%= s.CNS_Marks %>
                </td>
                <td>
                    <%= s.AI_marks %>
                </td>
                <td>
                    <%= s.Total %>
                </td>
                <td>
                    <%= s.Percentage.toFixed(2) %>
                </td>
            </tr>
            <% }) %>

    </table>

</body>

</html>